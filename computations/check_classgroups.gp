\\ Genus theory and power-residue ("Redei-type") bounds for K = Q(theta), theta^n = a(theta+1).
\\ Class groups are computed with bnfinit (GRH-conditional unless certified).
default(parisize, 10^9);

\\ order of the subgroup of (+)_i Z/d_i generated by the columns of A (and optional extra columns)
suborder(A, d) =
{
  my(r = #d, L);
  if (r == 0, return(1));
  L = concat(A, matdiagonal(d));
  prod(i = 1, r, d[i]) / abs(matdet(mathnf(L)));
}

\\ data attached to a squarefree a with gcd(a,n)=1
genusdata(n, a) =
{
  my(S = factor(abs(a))[,1]~, Sq = [], d = [], A, s, Phi, PhiS, gplus, greal);
  for (i = 1, #S, my(q = S[i], dq = gcd(n, q - 1)); if (dq > 1, Sq = concat(Sq, q); d = concat(d, dq)));
  A = matrix(#Sq, #S);
  for (i = 1, #Sq,
    my(q = Sq[i], gq = znprimroot(q));
    for (j = 1, #S,
      my(p = S[j]);
      if (p != q, A[i,j] = znlog(Mod(p, q), gq) % d[i],
                  A[i,j] = (-znlog(Mod((-1)^(n+1) * a / q, q), gq)) % d[i])));
  s = vector(#Sq, i, ((Sq[i] - 1)/2) % d[i])~;
  PhiS = suborder(A, d);
  my(PhiSs = suborder(concat(A, s), d), ords = if (#Sq == 0, 1, if (suborder(Mat(s), d) == 1, 1, 2)));
  gplus = prod(i = 1, #d, d[i]);
  \\ F_a real iff (q-1)/d_q even for all q
  my(Freal = 1); for (i = 1, #Sq, if (((Sq[i] - 1)/d[i]) % 2 == 1, Freal = 0));
  [S, Sq, d, A, s, PhiS, PhiSs / ords, gplus, Freal];
}

\\ order of subgroup of a finite abelian group with cyclic factors cyc generated by the columns of V
subgrouporder(V, cyc) =
{
  my(k = #cyc);
  if (k == 0, return(1));
  suborder(V, cyc);
}

check(n, a) =
{
  my(f = x^n - a*x - a, bnf, G, gd, h, hp, r1, cyc, cycp, bnr, V, Vp, S, P, Cw, Cn, gwide, ok = 1);
  bnf = bnfinit(f, 1);
  G = polgalois(f)[1];
  gd = genusdata(n, a);
  S = gd[1];
  cyc = bnf.cyc; h = bnf.no;
  r1 = bnf.sign[1];
  bnr = bnrinit(bnf, [1, vector(r1, i, 1)]);
  cycp = bnr.cyc; hp = bnr.no;
  V = matrix(#cyc, #S); Vp = matrix(#cycp, #S);
  for (j = 1, #S,
    P = idealprimedec(bnf, S[j]);
    if (#P != 1 || P[1].e != n, error("not totally ramified"));
    my(v = bnfisprincipal(bnf, P[1], 0), vp = bnrisprincipal(bnr, P[1], 0));
    for (i = 1, #cyc, V[i,j] = v[i]);
    for (i = 1, #cycp, Vp[i,j] = vp[i]));
  Cw = subgrouporder(V, cyc); Cn = subgrouporder(Vp, cycp);
  \\ predicted genus numbers (valid when K cap F_a = Q, e.g. G = S_n)
  gwide = if (r1 == 0 || gd[9], gd[8], gd[8] / 2);
  my(res = [n, a, G, cyc, h, hp, gd[8], gwide, gd[6], gd[7], Cw, Cn]);
  if (G == n!,
    if (hp % gd[8] != 0, ok = 0; print("  GENUS(narrow) FAILS ", res));
    if (h % gwide != 0, ok = 0; print("  GENUS(wide) FAILS ", res)));
  if (Cn < gd[6], ok = 0; print("  REDEI(narrow) FAILS ", res));
  if (Cw < gd[7], ok = 0; print("  REDEI(wide) FAILS ", res));
  [ok, res];
}

run(n, amin, amax, maxcount) =
{
  my(cnt = 0, fails = 0, sharpw = 0, sharpg = 0, nontriv = 0);
  forstep (a = amin, amax, 1,
    if (a == 0 || abs(a) == 1 || !issquarefree(a) || gcd(a, n) != 1, next);
    my(f = x^n - a*x - a);
    if (!polisirreducible(f), next);
    my(r = check(n, a));
    cnt++; if (!r[1], fails++);
    if (r[2][7] > 1, nontriv++);
    if (r[2][11] == r[2][10], sharpw++);
    if (cnt >= maxcount, break));
  print("n=", n, " a in [", amin, ",", amax, "]: fields=", cnt, " failures=", fails,
        " (genus number >1 in ", nontriv, "; Redei bound sharp for wide subgroup in ", sharpw, ")");
}

run(3, -1500, 1500, 10^6);
run(4, -400, 400, 10^6);
run(5, -150, 150, 10^6);
run(6, -60, 60, 10^6);
